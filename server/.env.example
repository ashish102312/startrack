# Server Port (default: 5001)
PORT=5001

# MongoDB Connection String (e.g. from MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/incident_tracker?retryWrites=true&w=majority

# Strong secret key for signing JWT tokens (Required in production)
JWT_SECRET=your_super_secret_jwt_key_here_change_me

# Allowed Frontend URL(s) for CORS (comma-separated if multiple)
CLIENT_URL=http://localhost:5173,https://your-frontend.vercel.app

# Optional admin secret to permit database reset in production
ADMIN_SECRET=your_admin_secret_key_here

# Environment ('development' or 'production')
NODE_ENV=development
